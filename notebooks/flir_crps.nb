Notebook[{
Cell["\<\
Notebook overview: This notebook compares thermal-image measurements acquired \
before and after an intervention. It defines scoring utilities, prompts for \
image files and temperature ranges, extracts raw FLIR thermal data with \
ExifTool, applies user-supplied masks, separates left and right regions, \
clusters temperature values, summarizes their distributions, and reports \
before-versus-after improvement metrics. Evaluate the cells from top to \
bottom. External prerequisites and intermediate files are described before \
the main workflow cell.\
\>", "Text",ExpressionUUID->"33195bb8-7ab1-4ca2-ae48-a63ecb2c50c4"],

Cell["\<\
Initialization: Clear every symbol in the Global` context so values and \
definitions left from an earlier kernel session cannot affect this analysis.\
\>", "Text",ExpressionUUID->"bfe4996f-e7db-4ae4-9112-e342c3f4190e"],

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}]}]], "Input",
 CellChangeTimes->{{3.882255752761848*^9, 3.882255754326461*^9}, {
  3.882255792009122*^9, 3.882255806256784*^9}, {3.882255849278998*^9, 
  3.882255861074121*^9}},
 CellLabel->
  "In[1568]:=",ExpressionUUID->"2e4f2e0e-bf5f-4d9f-a5e2-6b178367384c"],

Cell["\<\
Relative-improvement helper: impr[ho, hn] compares a new \
histogram/distribution hn with an original histogram/distribution ho. It \
normalizes score[ho, hn] by the original self-score score[ho, ho] and \
subtracts 1.0, so positive values indicate improvement relative to the \
baseline.\
\>", "Text",ExpressionUUID->"1c8087aa-c7d5-4035-880d-e480fe9ab9c7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"impr", "[", 
   RowBox[{"ho_", ",", " ", "hn_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"score", "[", 
        RowBox[{"ho", ",", "hn"}], "]"}], "/", 
       RowBox[{"score", "[", 
        RowBox[{"ho", ",", "ho"}], "]"}]}], ")"}], "-", "1.0"}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{
  3.843648155982181*^9, {3.843649421450548*^9, 3.84364945908124*^9}, {
   3.843649492641904*^9, 3.843649509507339*^9}, {3.843649746311814*^9, 
   3.843649754450795*^9}, {3.880559093471903*^9, 3.8805591148704863`*^9}, {
   3.880559162200541*^9, 3.880559199333859*^9}, {3.880559248619745*^9, 
   3.880559249171336*^9}},
 CellLabel->
  "In[1569]:=",ExpressionUUID->"2210a652-3a8c-4513-8438-a9b4ec074b9b"],

Cell["\<\
Directional probability helper: prob[hx, hy, dir] computes a weighted \
cumulative probability from two equal-length histogram vectors. For each bin \
of hy, it multiplies that bin weight by either the upper-tail cumulative mass \
of hx (dir == 1) or the lower-tail cumulative mass of hx (all other values). \
The accumulated result is returned as tot.\
\>", "Text",ExpressionUUID->"f09cc61a-7bda-4c82-a0b3-ad132d826c21"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"prob", "[", 
    RowBox[{"hx_", ",", " ", "hy_", ",", "dir_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"i", ",", "j", ",", "l", ",", "tot", ",", "tot2"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"l", " ", "=", " ", 
       RowBox[{"Length", "[", "hx", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"tot", " ", "=", "0"}], ";", "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"i", "=", "1"}], ",", 
        RowBox[{"i", "\[LessEqual]", "l"}], ",", " ", 
        RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"tot2", " ", "=", " ", "0"}], ";", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"dir", "\[Equal]", "1"}], ",", "\[IndentingNewLine]", 
           RowBox[{"For", "[", 
            RowBox[{
             RowBox[{"j", "=", "i"}], ",", 
             RowBox[{"j", "\[LessEqual]", "l"}], ",", " ", 
             RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"tot2", " ", "+=", " ", 
               RowBox[{"hx", "[", 
                RowBox[{"[", "j", "]"}], "]"}]}], ";"}]}], 
            "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", 
           RowBox[{"For", "[", 
            RowBox[{
             RowBox[{"j", "=", "1"}], ",", 
             RowBox[{"j", "\[LessEqual]", "i"}], ",", " ", 
             RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"tot2", " ", "+=", " ", 
               RowBox[{"hx", "[", 
                RowBox[{"[", "j", "]"}], "]"}]}], ";"}]}], 
            "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "]"}], ";",
          "\[IndentingNewLine]", 
         RowBox[{"tot", " ", "+=", " ", 
          RowBox[{
           RowBox[{"hy", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "*", "tot2"}]}], ";"}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", "tot"}]}], 
    "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]"}]], "Input",
 CellChangeTimes->{{3.843647734733181*^9, 3.843648022767384*^9}, {
  3.843648121479468*^9, 3.84364812994442*^9}, {3.843649468314855*^9, 
  3.843649490226403*^9}, {3.843649526433692*^9, 3.8436495587172337`*^9}, {
  3.843649834840375*^9, 3.843649852620498*^9}, {3.843649933298625*^9, 
  3.843649933569676*^9}, {3.843650119419907*^9, 3.843650133188474*^9}},
 CellLabel->
  "In[1570]:=",ExpressionUUID->"9c6d242c-94af-4549-b85d-dd64729fa494"],

Cell["\<\
Direction convention used by prob: dir == 0 selects the less-than-or-equal \
cumulative direction; dir == 1 selects the greater-than-or-equal cumulative \
direction.\
\>", "Text",ExpressionUUID->"0551478d-cd3f-426b-9bb6-5496b6c2e4c8"],

Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{"0", " ", "means", " ", "le"}], ";", " ", 
   RowBox[{"1", " ", "means", " ", "ge"}]}], "*)"}]], "Input",
 CellChangeTimes->{{3.843649602662914*^9, 3.843649619268797*^9}, 
   3.872162263839527*^9},
 CellLabel->
  "In[1571]:=",ExpressionUUID->"941a6ec6-fb76-47e7-86fd-e395eb81360a"],

Cell["\<\
Symmetric comparison score: score[hx, hy] averages two complementary \
directional probabilities. The first term compares hx against hy in the \
lower-tail direction; the second reverses the arguments and uses the \
upper-tail direction. This reduces dependence on a single ordering of the \
inputs.\
\>", "Text",ExpressionUUID->"396a9031-d0ce-4858-919a-a82708a3d4b5"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"score", "[", 
    RowBox[{"hx_", ",", " ", "hy_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "i", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"0.5", "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"prob", "[", 
         RowBox[{"hx", ",", "hy", ",", "0"}], "]"}], "+", 
        RowBox[{"prob", "[", 
         RowBox[{"hy", ",", "hx", ",", "1"}], "]"}]}], ")"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]"}]], "Input",
 CellChangeTimes->{{3.8436476243585377`*^9, 3.8436477432995872`*^9}, {
  3.843649571570565*^9, 3.8436495932616587`*^9}, {3.843649708657325*^9, 
  3.843649742389932*^9}},
 CellLabel->
  "In[1572]:=",ExpressionUUID->"0a7be39d-ccd2-4484-9acc-c2edd7911809"],

Cell["", "Text",
 CellChangeTimes->{
  3.993349589716386*^9},ExpressionUUID->"801e38ca-035e-4719-94d4-\
7945f6704d21"],

Cell[BoxData[""], "Input",
 CellChangeTimes->{{3.880545376277227*^9, 3.880545389368738*^9}, {
  3.993349546637074*^9, 
  3.993349587374589*^9}},ExpressionUUID->"777b2d32-548a-43d4-9f80-\
f3061795b376"],

Cell["\<\
Main workflow and external requirements:

1. Working directory and camera range: The user selects the folder containing \
the images and intermediate files. The camera calibration range is set to -20 \
to 120 degrees Celsius.

2. Before image: The notebook imports the visible JPEG, asks for the image \
ratio and observed temperature limits, and instructs the user to extract the \
embedded raw thermal image with ExifTool into before_thermal.png.

3. Before thermal calibration: The 16-bit thermal pixel data are converted \
into the requested temperature interval. Optional reversal/orientation \
handling is controlled interactively.

4. Before mask and regions: A user-created before_mask.png is imported and \
applied. The masked image is divided into left and right regions according to \
the supplied ratio, and background pixels are removed.

5. Before statistics: Pixel values for both regions are flattened, filtered, \
clustered, counted, assigned cluster centers/labels/colors, and converted \
into scores, heat summaries, pie charts, and histograms.

6. After image: The same import, raw-thermal extraction, calibration, \
masking, left/right separation, background removal, clustering, and \
visualization sequence is repeated for the after image using \
after_thermal.png and after_mask.png.

7. Comparison: The resulting before and after distributions are compared with \
score and impr to quantify change for the left and right regions.

External prerequisite: ExifTool must be available from a command line. When \
prompted, run the exact command printed by the notebook to create the \
required raw-thermal PNG, then return to Mathematica.

File prerequisite: Place the source JPEG files and the manually prepared mask \
PNG files in the selected working directory. The mask dimensions should \
correspond to the associated thermal image.

Execution note: This is an interactive workflow; InputString prompts and \
manual file-generation steps intentionally pause evaluation until the \
requested input or file is ready.\
\>", "Text",ExpressionUUID->"daa967ab-5e48-4f07-947e-d785d8dcffaf"],

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"directoryName", " ", "=", " ", 
     RowBox[{"InputString", "[", "\"\<Directory> \>\"", "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"SetDirectory", "[", "directoryName", "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Directory", "[", "]"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"command", " ", 
     RowBox[{"line", ":", " ", 
      RowBox[{"exiftool", " ", "-", 
       RowBox[{"all", " ", 
        RowBox[{"FLIR0006", ".", "jpg"}]}]}]}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"minTempCamera", " ", "=", " ", 
     RowBox[{"-", "20"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"maxTempCamera", " ", "=", " ", "120"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{
     "\"\<Input Image (Before): \>\"", ",", " ", 
      "\"\< ---------------- \>\""}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"beforeimageName", " ", "=", " ", 
     RowBox[{
     "InputString", "[", "\"\<Before Image file name (JPG)> \>\"", "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"beforeimage", " ", "=", " ", 
     RowBox[{"Import", "[", "beforeimageName", "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "beforeimage", "]"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"bRatio", "  ", "=", " ", 
     RowBox[{"ToExpression", "[", 
      RowBox[{"InputString", "[", "\"\<Before image ratio> \>\"", "]"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"beforeminTemp", " ", "=", "  ", 
     RowBox[{"ToExpression", "[", 
      RowBox[{"InputString", "[", "\"\<Minimum Temperature(C)> \>\"", "]"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"beforemaxTemp", " ", "=", "  ", 
     RowBox[{"ToExpression", "[", 
      RowBox[{"InputString", "[", "\"\<Maximum Temperature(C)> \>\"", "]"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Run", "[", 
      RowBox[{"\"\<cp \>\"", "<>", "imageName", "<>", "\"\< try.jpg\>\""}], 
      "]"}], ";"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"DeleteFile", "[", "\"\<before_thermal.png\>\"", "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{
     "\"\<Execute the following command: exiftool -b -rawthermalimage \>\"", "<>",
       "beforeimageName", "<>", "\"\< > before_thermal.png\>\""}], "]"}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Run", "[", 
      RowBox[{
      "\"\<exiftool -b -rawthermalimage \>\"", "<>", "directoryName", " ", 
       "<>", "\"\</\>\"", "<>", "beforeimageName", "<>", 
       "\"\< > YYY_thermal.png\>\""}], "]"}], ";"}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"thermalImageName", " ", "=", " ", 
      RowBox[{
      "InputString", "[", "\"\<Thermal image file name (PNG)> \>\"", "]"}]}], 
     ";"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"cFlag", " ", "=", " ", 
     RowBox[{"InputString", "[", 
      RowBox[{
      "\"\<Execute the command:\\n     exiftool -b -rawthermalimage \>\"", "<>",
        "beforeimageName", "<>", "\"\< > before_thermal.png\\n \>\"", " ", "<>",
        " ", "\"\<and click when 'before_thermal.png' is ready\>\""}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "beforethermalImageName", " ", "=", " ", "\"\<before_thermal.png\>\""}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"beforeimage", " ", "=", " ", 
     RowBox[{"Import", "[", "beforethermalImageName", "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "beforeimage", "]"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"beforeimData", " ", "=", " ", 
     RowBox[{"ImageData", "[", 
      RowBox[{"beforeimage", ",", "\"\<Bit16\>\""}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Print", "[", "imData", "]"}], ";"}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"revFlag", " ", "=", " ", 
     RowBox[{
     "InputString", "[", "\"\<Process before image? (Y/N)> \>\"", "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"revFlag", " ", "\[NotEqual]", " ", "\"\<N\>\""}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"beforerevData", " ", "=", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"Mod", "[", 
             RowBox[{"#", ",", "256"}], "]"}], "*", "256"}], " ", "+", " ", 
           RowBox[{"Quotient", "[", 
            RowBox[{"#", ",", "256"}], "]"}]}], ")"}], " ", "&"}], "/@", 
        "beforeimData"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{"beforerevData", " ", "=", " ", "beforeimData"}]}], 
     "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"beforemaxData", " ", "=", " ", 
     RowBox[{"Max", "[", "beforerevData", "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"beforeminData", " ", "=", " ", 
     RowBox[{"Min", "[", "beforerevData", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"beforerevData", " ", "=", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"#", "-", "beforeminData"}], ")"}], "/", 
         RowBox[{"(", 
          RowBox[{"beforemaxData", "-", "beforeminData"}], ")"}]}], ")"}], 
       "&"}], "/@", "beforerevData"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"beforeimage", " ", "=", " ", 
     RowBox[{"Image", "[", "beforerevData", "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"beforeimageSize", "=", " ", 
     RowBox[{"ImageDimensions", "[", "beforeimage", "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"beforewidth", " ", "=", " ", 
     RowBox[{"beforeimageSize", "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"beforeheight", " ", "=", " ", 
     RowBox[{"beforeimageSize", "[", 
      RowBox[{"[", "2", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{
     "\"\<Processed Before Image: \>\"", ",", " ", 
      "\"\< ---------------- \>\""}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "beforeimage", "]"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"beforeRWidth", " ", "=", " ", 
     RowBox[{"beforewidth", " ", "*", " ", "bRatio"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"beforeLWidth", " ", "=", " ", 
     RowBox[{"beforewidth", " ", "*", " ", 
      RowBox[{"(", 
       RowBox[{"1", "-", "bRatio"}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"cFlag", " ", "=", " ", 
     RowBox[{
     "InputString", "[", 
      "\"\<Save mask as 'before_mask.png' and click when the mask is \
ready\>\"", "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"beforemaskImage", " ", "=", " ", 
     RowBox[{"Import", "[", 
      RowBox[{"\"\<before_mask.png\>\"", ",", 
       RowBox[{"ImageSize", "\[Rule]", " ", "beforeimageSize"}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"beforemaskSize", " ", "=", " ", 
      RowBox[{"ImageDimensions", "[", "beforemaskImage", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"beforemaskWidth", " ", "=", " ", 
      RowBox[{"beforemaskSize", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"beforemaskHeight", " ", "=", " ", 
      RowBox[{"beforemaskSize", "[", 
       RowBox[{"[", "2", "]"}], "]"}]}], ";"}], "*)"}], "\[IndentingNewLine]",
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ImageResize", "[", 
     RowBox[{"beforemaskImage", ",", 
      RowBox[{"{", 
       RowBox[{"beforewidth", ",", "beforeheight"}], "}"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"beforeimage", " ", "=", " ", 
     RowBox[{"ImageMultiply", "[", 
      RowBox[{"beforeimage", ",", "beforemaskImage"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"beforeleftImage", " ", "=", " ", 
     RowBox[{"ImageCrop", "[", 
      RowBox[{"beforeimage", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Floor", "[", "beforeLWidth", "]"}], ",", "beforeheight"}], 
        "}"}], ",", "Left"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"beforerightImage", " ", "=", " ", 
     RowBox[{"ImageCrop", "[", 
      RowBox[{"beforeimage", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Floor", "[", "beforeRWidth", "]"}], ",", "beforeheight"}], 
        "}"}], ",", "Right"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", "**)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{
     "beforerightImage", ",", "\"\< \>\"", ",", " ", "beforeleftImage"}], 
     "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", "**)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{
     "\"\<Left and right before images: \>\"", ",", " ", 
      "\"\< ---------------- \>\""}], "]"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"beforelComposed", "=", " ", "beforeleftImage"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"beforerComposed", "=", "beforerightImage"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"beforewidth", " ", "=", " ", 
      RowBox[{"Floor", "[", 
       RowBox[{"beforewidth", "/", "2"}], "]"}]}], ";"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"beforeheight", " ", "=", " ", "beforeheight"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{
     "beforerComposed", ",", "\"\< \>\"", ",", " ", "beforelComposed"}], 
     "]"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{
     "\"\<Left and right foreground Before images: \>\"", ",", " ", 
      "\"\< ---------------- \>\""}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"beforenbRImage", " ", "=", " ", 
     RowBox[{"RemoveBackground", "[", 
      RowBox[{"beforerComposed", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", "1"}], "}"}], ",", "0"}], "}"}]}], "]"}]}], ";"}],
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"beforenbLImage", " ", "=", " ", 
     RowBox[{"RemoveBackground", "[", 
      RowBox[{"beforelComposed", ",", 
       RowBox[{"{", 
